# ---- Android / Gradle build output ----
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.idea/
*.iml
*.hprof

# Generated assets (copied from ../www by the syncWebApp task)
android/app/build/generated/

# Native libs / crash dumps
*.so
hs_err_pid*.log

# ---- Keystores and secrets (never commit real signing keys) ----
*.jks
*.keystore
keystore.properties

# ---- APK / AAB artifacts ----
*.apk
*.aab
*.apks

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
.vscode/
*.swp

# NOTE: do NOT ignore android/gradle/wrapper/gradle-wrapper.jar.
# It is generated by the CI workflow (see .github/workflows/android.yml).
